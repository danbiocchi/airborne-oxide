# ArduCopter V4.7.2 parameters for a bridged flight of the reference quad
# (airframes/quad-x-5in.toml). One `NAME VALUE` per line. Gains are not here:
# they are in starting-gains.parm.

# Frame: a quad in the X layout. Without these ArduCopter never arms
# ("PreArm: Motors: Check frame class and type") and its outputs stay at 0.
# ADR-0006 section 5 (motors), ADR-0007 section 2 step 1.
FRAME_CLASS 1
FRAME_TYPE 1

# Thrust curve: our rotors give thrust as the square of the command
# (exponent 1.0), and the hover command is near the learned value (0.154 on a
# full pack). MOT_SPIN_ARM, MOT_SPIN_MIN and MOT_SPIN_MAX stay at their
# defaults. ADR-0007 section 2 steps 1 and 3.
MOT_THST_EXPO 1.0
MOT_THST_HOVER 0.16

# Sensors that match our models (ADR-0006 section 4). SITL adds a slow gyro
# drift of its own unless it is switched off; its barometer, compass and GPS
# velocity noise are set to our values (measured in the spike: 0.10 m,
# about 0.5 uT, 0.1 m/s); the GPS delay is ours, 150 ms. SIM_GPS1_NOISE
# noises the GPS height only (std 0.21 m at 0.3; it does nothing to the
# horizontal position): the horizontal error is added by the bridge.
SIM_DRIFT_SPEED 0
SIM_BARO_RND 0.173
SIM_MAG_RND 27
SIM_GPS1_LAG_MS 150
SIM_GPS1_VERR_X 0.1
SIM_GPS1_VERR_Y 0.1
SIM_GPS1_VERR_Z 0.1
SIM_GPS1_NOISE 0.3

# The battery: monitor type 4 reads the voltage and current we send in the
# reply (ADR-0006 section 4).
BATT_MONITOR 4

# No log file: a flight with the log on does not repeat (ADR-0006 section 8).
LOG_BACKEND_TYPE 0

# A tumbling vehicle (a motor-loss fault) raises a floating-point exception
# that aborts SITL unless this is off (ADR-0006 section 6).
SIM_FLOAT_EXCEPT 0

# The radio as the bridge sends it (ADR-0006 section 6): channel 5 is the
# mode switch, 1000 us STABILIZE (our Stabilized), 1500 us LOITER (Position),
# 2000 us GUIDED (Offboard). Channel 6 is the arm switch (function 153,
# arm/disarm); in GUIDED, arming from the radio needs GUID_OPTIONS bit 0.
# Channel 7 is the motor emergency stop (function 31), our kill switch.
FLTMODE_CH 5
FLTMODE1 0
FLTMODE4 5
FLTMODE6 4
RC6_OPTION 153
GUID_OPTIONS 1
RC7_OPTION 31
